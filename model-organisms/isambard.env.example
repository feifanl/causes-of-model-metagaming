# Copy to ~/.config/spar/env, fill in, then: chmod 600 ~/.config/spar/env  (ISAMBARD.md step 2)

# A directory with ~2.5 TB free (models, judges, checkpoints, logs).
DATA_DIR=/path/to/big/disk/eval-awareness-data

# Read token
HF_TOKEN=
# Write token
HF_WRITE_TOKEN=
HF_ARTIFACT_REPO=feifanliu/eval-awareness-model-organisms

# Only with Slurm, if the admins say jobs need them (sbatch reads these)
# SBATCH_ACCOUNT=
# SBATCH_PARTITION=
# Optional, with Slurm: an email when a job ends
# NOTIFY_EMAIL=

# Will be set later, Feifan will communicate when to do so
SDF_LR=
