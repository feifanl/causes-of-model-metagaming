# Copy to ~/.config/spar/env and fill in (ISAMBARD.md step 2).

# New directory on the project storage; the run uses ~2.5 TB (models, judges, checkpoints, logs).
DATA_DIR=/path/to/project/storage/eval-awareness-data

# The two tokens Feifan sends
HF_TOKEN=
HF_WRITE_TOKEN=
HF_ARTIFACT_REPO=feifanliu/eval-awareness-model-organisms

# Only if the admins say jobs need them
# SBATCH_ACCOUNT=
# SBATCH_PARTITION=
# Optional: an email when a job ends
# NOTIFY_EMAIL=

# Leave empty; Feifan sends it after the redwood step
SDF_LR=
