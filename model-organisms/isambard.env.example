# Copy to ~/.config/spar/env, fill in, then: chmod 600 ~/.config/spar/env  (ISAMBARD.md step 2)

# A directory with ~2.5 TB free (models, judges, checkpoints, logs); not under $HOME.
DATA_DIR=$SCRATCHDIR/eval-awareness-data

# Read token
HF_TOKEN=
# Write token
HF_WRITE_TOKEN=
HF_ARTIFACT_REPO=feifanliu/eval-awareness-model-organisms

# Only if the admins say jobs need them (sbatch reads these)
# SBATCH_ACCOUNT=
# SBATCH_PARTITION=
# Optional: an email from Slurm when a job ends
# NOTIFY_EMAIL=

# Will be set later, Feifan will communicate when to do so
SDF_LR=
