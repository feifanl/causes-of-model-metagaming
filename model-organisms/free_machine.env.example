# Copy to ~/.config/spar/env, fill in, then: chmod 600 ~/.config/spar/env  (FREE_MACHINE.md step 2)
# Only Hugging Face tokens: no key that spends money is needed or wanted on this machine.

# A scratch directory with at least 1.5 TB free (models, checkpoints, logs).
DATA_DIR=/path/to/scratch/eval-awareness

# Read token (fine-grained) for the account that accepted the Llama-3.3 and GPQA terms.
HF_TOKEN=
# Write token (fine-grained) limited to the one repo below; results and logs are uploaded there.
HF_WRITE_TOKEN=
HF_ARTIFACT_REPO=feifanliu/eval-awareness-model-organisms

# Set by Feifan once lr_test has been read (stage1 refuses to start without it), e.g. SDF_LR=3e-5
SDF_LR=
